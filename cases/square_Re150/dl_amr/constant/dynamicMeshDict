FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}

dynamicFvMesh   dynamicRefine2DFvMesh;

dynamicRefine2DFvMeshCoeffs
{
    refineInterval  40;

    field           refineFlag;

    lowerRefineLevel 0.9;
    upperRefineLevel 1.1;

    unrefineLevel   0.8;

    nBufferLayers   2;

    maxRefinement   2;

    maxCells        200000;

    correctFluxes
    (
        (phi none)
        (phi_0 none)
        (phi_0_0 none)
        (ghf none)
    );

    dumpLevel       true;

    protectMode     none;
    protectMin      (-2 -2 -0.5);
    protectMax      (2 2 0.5);
}
