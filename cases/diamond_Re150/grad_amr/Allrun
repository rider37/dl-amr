#!/usr/bin/env bash
# diamond_Re150 / grad_amr  --  restart run, 95 -> 256
set -euo pipefail
cd "$(dirname "$0")"

if [ ! -d "95" ]; then
    echo "ERROR: restart state '95/' not found."
    echo "Adaptive and static variants restart from a common coarse-mesh state."
    echo "See ../README.md ('Restart protocol')."
    exit 1
fi

pimpleFoam > log.pimpleFoam 2>&1
